{
  "name": "@sparkyie/api",
  "version": "2.0.0",
  "description": "A small, framework-agnostic Axios client for Vue and web applications.",
  "main": "dist/sparkyie-api.mjs",
  "module": "dist/sparkyie-api.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sparkyie-api.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run type-check && vite build --mode lib && tsc -p tsconfig.lib.json",
    "type-check": "vue-tsc --build --force",
    "test:request": "npm run build && node scripts/test-request.mjs",
    "validate": "npm run type-check && npm run test:request",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "qs": "^6.14.0",
    "vue": "^3.4.29"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.5",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.2.5",
    "typescript": "~5.4.0",
    "vite": "^5.3.1",
    "vue-tsc": "^2.0.21"
  }
}
